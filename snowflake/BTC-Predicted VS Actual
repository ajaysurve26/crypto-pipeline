CREATE OR REPLACE VIEW VW_PREDICTIONS AS
SELECT
    SYMBOL,
    WINDOW_START,
    PREDICTED_NEXT_CLOSE,
    TARGET_NEXT_CLOSE
FROM PREDICTIONS_NEXT_MINUTE;

SELECT
    SYMBOL,
    WINDOW_START,
    PREDICTED_NEXT_CLOSE,
    TARGET_NEXT_CLOSE
FROM VW_PREDICTIONS
WHERE SYMBOL = 'BTC'
ORDER BY WINDOW_START;
