USE DATABASE CRYPTO_ANALYTICS;
USE SCHEMA PUBLIC;


CREATE OR REPLACE VIEW VW_PREDICTIONS AS
SELECT
    SYMBOL,
    WINDOW_START,
    PREDICTED_NEXT_CLOSE,
    TARGET_NEXT_CLOSE
FROM PREDICTIONS_NEXT_MINUTE;

SELECT
    WINDOW_START,
    SYMBOL,
    TARGET_NEXT_CLOSE,
    PREDICTED_NEXT_CLOSE,
    ROUND(
        ABS(TARGET_NEXT_CLOSE - PREDICTED_NEXT_CLOSE) / TARGET_NEXT_CLOSE * 100,
        4
    ) AS PERCENT_ERROR
FROM VW_PREDICTIONS
WHERE SYMBOL = 'BTC'
ORDER BY WINDOW_START DESC
LIMIT 60;
